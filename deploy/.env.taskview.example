# Configuración de la API de TaskView. init.ps1 copia este archivo a .env.taskview y genera los secretos.
# Referencia completa: docs/4.configuration/1.environment-variables.md
# Las variables DB_* las inyecta docker-compose.yml a partir de .env.

APP_PORT=1401
PM2_INSTANCES=2
DB_POOL_MAX=20

# Debe coincidir con WEB_PORT de .env
APP_URL="http://localhost:8888"
CORS_ALLOWED_ORIGINS="http://localhost:8888,http://127.0.0.1:8888"

JWT_ALG="HS256"
JWT_SIGN="__GENERATE__"
ACCESS_LIFE_TIME="3d"
REFRESH_LIFE_TIME="9d"

# Cifra los tokens de integraciones (GitHub/GitLab) y SSO. Si se pierde, hay que reconectarlas.
ENCRYPTION_KEY="__GENERATE__"

# Sin SMTP: solo login con contraseña y cambios de contraseña confirmados con la actual.
AUTH_LOGIN_METHODS="password"
PASSWORD_CHANGE_CONFIRMATION="password"

# Instancia cerrada: solo entran correos invitados a una organización o proyecto.
ALLOW_PUBLIC_REGISTRATION="false"

# Webhooks hacia servicios de la red privada (n8n, CI interno...)
WEBHOOKS_ALLOW_PRIVATE_URLS=false

# SMTP (opcional: invitaciones por correo, recuperación de contraseña)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_ENCRYPTION=tls
#SMTP_FROM_NAME=TaskView
#SMTP_FROM_EMAIL=

# Integración con GitHub (opcional): ver docs/3.integrations/1.setup.md
#GITHUB_INTEGRATION_CLIENT_ID=
#GITHUB_INTEGRATION_CLIENT_SECRET=
#GITHUB_INTEGRATION_CALLBACK_URL=http://localhost:1725/module/integrations/oauth/github/callback

# Variables de Docker Compose. init.ps1 copia este archivo a .env y genera la contraseña.

# Versión de las imágenes gimanhead/taskview-ce-* (https://hub.docker.com/u/gimanhead)
TASKVIEW_VERSION=1.56.0

# Puertos en 127.0.0.1
WEB_PORT=8888
API_PORT=1725
MCP_PORT=3100

# Base de datos
POSTGRES_USER=taskview
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=taskview
